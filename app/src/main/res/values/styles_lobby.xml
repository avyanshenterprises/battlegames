<resources>
    <style name="LobbyNav">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="LobbyNavIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="LobbyNavText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">#FFE8F4FA</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="LobbyMode">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_mode_card</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="LobbyModeTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="LobbyModeSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFB5C9D5</item>
        <item name="android:textSize">9sp</item>
    </style>
    <style name="LobbyNavV">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="LobbyNavVIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="LobbyNavVText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFE8F4FA</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">8sp</item>
    </style>
    <style name="LobbySeg">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#C6D8E6</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="LobbyTopBtn">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/bg_btn_round</item>
        <item name="android:scaleType">center</item>
        <item name="android:contentDescription">@null</item>
    </style>
</resources>
