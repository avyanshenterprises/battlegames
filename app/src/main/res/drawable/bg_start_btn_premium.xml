<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6A21E"
                android:endColor="#C8860E" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFE58A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFE58A"
                android:centerColor="#FFD45A"
                android:endColor="#E6A21E" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFF2BC" />
        </shape>
    </item>
</selector>