<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/lobby_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#05090F">
	<FrameLayout
		android:id="@+id/game_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />
	<FrameLayout
		android:id="@+id/lobby_panel"
		android:layout_width="match_parent"
		android:layout_height="match_parent">
		<View
			android:id="@+id/lobby_left_rail"
			android:layout_width="86dp"
			android:layout_height="match_parent"
			android:background="@drawable/bg_left_rail"
			android:layout_gravity="start" />
		<LinearLayout
			android:id="@+id/profile_card"
			android:layout_width="wrap_content"
			android:layout_height="58dp"
			android:layout_marginTop="12dp"
			android:background="@drawable/bg_panel_ff"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:layout_gravity="start|top"
			android:layout_marginStart="12dp"
			android:paddingStart="6dp"
			android:paddingEnd="16dp">
			<FrameLayout
				android:id="@+id/avatar_frame"
				android:layout_width="46dp"
				android:layout_height="46dp"
				android:background="@drawable/bg_avatar_ring">
				<ImageView
					android:id="@+id/avatar_img"
					android:layout_width="28dp"
					android:layout_height="28dp"
					android:src="@drawable/ic_person"
					android:scaleType="center"
					android:layout_gravity="center_horizontal|center_vertical"
					android:contentDescription="@null" />
			</FrameLayout>
			<LinearLayout
				android:id="@+id/linear11"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginStart="10dp">
				<LinearLayout
					android:id="@+id/linear12"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/lobby_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Player"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
					<TextView
						android:id="@+id/lobby_edit"
						android:layout_width="wrap_content"
						android:layout_height="18dp"
						android:background="@drawable/bg_hud_chip"
						android:gravity="center_horizontal|center_vertical"
						android:text="EDIT"
						android:textSize="8sp"
						android:textStyle="bold"
						android:textColor="#FFD45A"
						android:layout_marginStart="6dp"
						android:paddingStart="6dp"
						android:paddingEnd="6dp" />
				</LinearLayout>
				<TextView
					android:id="@+id/lobby_uid"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="UID  ---"
					android:textSize="10sp"
					android:textColor="#9CB3C4" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/top_actions"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:layout_gravity="end|top"
			android:layout_marginEnd="12dp">
			<LinearLayout
				android:id="@+id/chip_coins"
				android:layout_width="wrap_content"
				android:layout_height="28dp"
				android:background="@drawable/bg_chip"
				android:gravity="center_vertical"
				android:paddingStart="8dp"
				android:paddingEnd="10dp">
				<ImageView
					android:id="@+id/imageview9"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:src="@drawable/ic_coin"
					android:scaleType="centerCrop"
					android:contentDescription="Coins" />
				<TextView
					android:id="@+id/text_coins"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFD36A"
					android:layout_marginStart="5dp" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/chip_diamonds"
				android:layout_width="wrap_content"
				android:layout_height="28dp"
				android:background="@drawable/bg_chip"
				android:gravity="center_vertical"
				android:layout_marginStart="6dp"
				android:paddingStart="8dp"
				android:paddingEnd="10dp">
				<ImageView
					android:id="@+id/imageview10"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:src="@drawable/ic_diamond"
					android:scaleType="centerCrop"
					android:contentDescription="@null" />
				<TextView
					android:id="@+id/text_diamonds"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#6FE6FF"
					android:layout_marginStart="5dp" />
			</LinearLayout>
			<ImageView
				android:id="@+id/lobby_mail"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:src="@drawable/ic_mail"
				android:scaleType="center"
				style="@style/LobbyTopBtn"
				android:layout_marginStart="6dp"
				android:contentDescription="@null" />
			<ImageView
				android:id="@+id/lobby_shop"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:src="@drawable/ic_cart"
				android:scaleType="center"
				style="@style/LobbyTopBtn"
				android:contentDescription="@null" />
			<ImageView
				android:id="@+id/lobby_settings"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:src="@drawable/ic_settings"
				android:scaleType="center"
				style="@style/LobbyTopBtn"
				android:contentDescription="@null" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/nav_rail"
			android:layout_width="70dp"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:layout_gravity="start|center_vertical"
			android:layout_marginStart="8dp">
			<LinearLayout
				android:id="@+id/nav_character"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_nav_item_active"
				style="@style/LobbyNavV">
				<ImageView
					android:id="@+id/imageview11"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/ic_person"
					android:scaleType="center"
					style="@style/LobbyNavVIcon"
					android:contentDescription="@null" />
				<TextView
					android:id="@+id/textview9"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="HERO"
					android:textSize="10sp"
					style="@style/LobbyNavVText" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/nav_weapons"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_nav_item"
				style="@style/LobbyNavV">
				<ImageView
					android:id="@+id/imageview12"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/default_image"
					android:scaleType="center"
					style="@style/LobbyNavVIcon"
					android:contentDescription="@null" />
				<TextView
					android:id="@+id/textview10"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="ARMS"
					android:textSize="10sp"
					style="@style/LobbyNavVText" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/nav_vault"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_nav_item"
				style="@style/LobbyNavV">
				<ImageView
					android:id="@+id/imageview13"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/ic_bag"
					android:scaleType="center"
					style="@style/LobbyNavVIcon"
					android:contentDescription="@null" />
				<TextView
					android:id="@+id/textview11"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="VAULT"
					android:textSize="10sp"
					style="@style/LobbyNavVText" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/nav_pet"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_nav_item"
				style="@style/LobbyNavV">
				<ImageView
					android:id="@+id/imageview14"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/ic_paw"
					android:scaleType="center"
					style="@style/LobbyNavVIcon"
					android:contentDescription="@null" />
				<TextView
					android:id="@+id/textview12"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="PET"
					android:textSize="10sp"
					style="@style/LobbyNavVText" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/nav_collection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_nav_item"
				style="@style/LobbyNavV">
				<ImageView
					android:id="@+id/imageview15"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/ic_star"
					android:scaleType="center"
					style="@style/LobbyNavVIcon"
					android:contentDescription="@null" />
				<TextView
					android:id="@+id/textview13"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="GEAR"
					android:textSize="10sp"
					style="@style/LobbyNavVText" />
			</LinearLayout>
		</LinearLayout>
		<FrameLayout
			android:id="@+id/friends_btn_frame"
			android:layout_width="52dp"
			android:layout_height="52dp"
			android:layout_marginBottom="14dp"
			android:layout_gravity="start|bottom"
			android:layout_marginStart="12dp">
			<ImageView
				android:id="@+id/lobby_friends"
				android:layout_width="46dp"
				android:layout_height="46dp"
				android:padding="11dp"
				android:background="@drawable/bg_btn_round"
				android:src="@drawable/ic_group"
				android:scaleType="center"
				android:layout_gravity="center_horizontal|center_vertical"
				android:contentDescription="@null" />
			<TextView
				android:id="@+id/friends_badge"
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:background="@drawable/bg_badge"
				android:gravity="center_horizontal|center_vertical"
				android:text="0"
				android:textSize="9sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:layout_gravity="end|top"
				android:visibility="gone" />
		</FrameLayout>
		<LinearLayout
			android:id="@+id/right_panel"
			android:layout_width="272dp"
			android:layout_height="match_parent"
			android:paddingTop="86dp"
			android:paddingBottom="16dp"
			android:orientation="vertical"
			android:layout_gravity="end"
			android:paddingStart="4dp"
			android:paddingEnd="12dp">
			<ScrollView
				android:id="@+id/right_scroll"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:fillViewport="false"
				android:overScrollMode="never"
				android:scrollbars="none">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="bottom"
					android:orientation="vertical">
					<FrameLayout
						android:id="@+id/map_card"
						android:layout_width="match_parent"
						android:layout_height="124dp"
						android:layout_marginBottom="10dp"
						android:padding="3dp"
						android:background="@drawable/bg_panel_ff">
						<TextView
							android:id="@+id/textview14"
							android:layout_width="wrap_content"
							android:layout_height="20dp"
							android:layout_margin="6dp"
							android:background="@drawable/bg_hud_chip"
							android:gravity="center_vertical"
							android:text="\u25C6 FRIENDS"
							android:textSize="9sp"
							android:textStyle="bold"
							android:textColor="#FFD45A"
							android:paddingStart="8dp"
							android:paddingEnd="8dp" />
						<TextView
							android:id="@+id/friends_preview_text"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_gravity="center_vertical|start"
							android:layout_marginStart="8dp"
							android:layout_marginTop="12dp"
							android:text="Friends, requests and squad invitations"
							android:textColor="#DCE8F2"
							android:textSize="11sp" />
						<TextView
							android:id="@+id/friends_preview_open"
							android:layout_width="wrap_content"
							android:layout_height="28dp"
							android:layout_gravity="bottom|end"
							android:layout_margin="7dp"
							android:gravity="center"
							android:paddingStart="12dp"
							android:paddingEnd="12dp"
							android:background="@drawable/bg_hud_chip"
							android:text="OPEN FRIENDS  ›"
							android:textColor="#FFD45A"
							android:textSize="10sp"
							android:textStyle="bold" />
					</FrameLayout>
					<LinearLayout
						android:id="@+id/mode_toggle"
						android:layout_width="match_parent"
						android:layout_height="40dp"
						android:padding="4dp"
						android:background="@drawable/bg_mode_toggle"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/mode_br"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:background="@drawable/bg_mode_selected"
							android:gravity="center_horizontal|center_vertical"
							android:text="OFFLINE"
							android:textSize="12sp"
							android:textStyle="bold"
							android:textColor="#17212B"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/mode_online"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:gravity="center_horizontal|center_vertical"
							android:text="ONLINE"
							android:textSize="12sp"
							android:textStyle="bold"
							android:textColor="#C6D8E6"
							android:layout_weight="1" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/online_box"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:padding="10dp"
						android:background="@drawable/bg_panel_ff"
						android:orientation="vertical"
						android:visibility="gone">
						<LinearLayout
							android:id="@+id/online_idle"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/linear14"
								android:layout_width="match_parent"
								android:layout_height="36dp"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/btn_quick"
									android:layout_width="0dp"
									android:layout_height="match_parent"
									android:background="@drawable/bg_btn_secondary"
									android:gravity="center_horizontal|center_vertical"
									android:text="QUICK MATCH"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFD45A"
									android:layout_weight="1" />
								<TextView
									android:id="@+id/btn_create"
									android:layout_width="0dp"
									android:layout_height="match_parent"
									android:background="@drawable/bg_btn_secondary"
									android:gravity="center_horizontal|center_vertical"
									android:text="CREATE ROOM"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFD45A"
									android:layout_weight="1"
									android:layout_marginStart="6dp" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear15"
								android:layout_width="match_parent"
								android:layout_height="38dp"
								android:layout_marginTop="6dp"
								android:orientation="horizontal">
								<EditText
									android:id="@+id/room_code"
									android:layout_width="0dp"
									android:layout_height="match_parent"
									android:background="@drawable/bg_input"
									android:textSize="12sp"
									android:textColor="#FFFFFF"
									android:hint="ENTER ROOM CODE"
									android:textColorHint="#6F8798"
									android:singleLine="true"
									android:imeOptions="actionDone"
									android:layout_weight="1"
									android:inputType="textCapCharacters"
									android:maxLength="8"
									android:paddingStart="10dp" />
								<TextView
									android:id="@+id/btn_join"
									android:layout_width="70dp"
									android:layout_height="match_parent"
									android:background="@drawable/bg_btn_secondary"
									android:gravity="center_horizontal|center_vertical"
									android:text="JOIN"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFD45A"
									android:layout_marginStart="6dp" />
							</LinearLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/online_room"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:visibility="gone">
							<LinearLayout
								android:id="@+id/linear16"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/room_code_text"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="ROOM -----"
									android:textSize="17sp"
									android:textStyle="bold"
									android:textColor="#FFD45A"
									android:layout_weight="1" />
								<TextView
									android:id="@+id/btn_copy_room"
									android:layout_width="wrap_content"
									android:layout_height="28dp"
									android:background="@drawable/bg_btn_secondary"
									android:gravity="center_horizontal|center_vertical"
									android:text="COPY"
									android:textSize="10sp"
									android:textStyle="bold"
									android:textColor="#FFD45A"
									android:paddingStart="10dp"
									android:paddingEnd="10dp" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear17"
								android:layout_width="match_parent"
								android:layout_height="32dp"
								android:layout_marginTop="8dp"
								android:padding="3dp"
								android:background="@drawable/bg_mode_toggle"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/team_solo"
									android:layout_width="0dp"
									android:layout_height="match_parent"
									android:gravity="center_horizontal|center_vertical"
									android:text="SOLO"
									android:textSize="10sp"
									android:textStyle="bold"
									android:textColor="#C6D8E6"
									android:layout_weight="1" />
								<TextView
									android:id="@+id/team_duo"
									android:layout_width="0dp"
									android:layout_height="match_parent"
									android:gravity="center_horizontal|center_vertical"
									android:text="DUO"
									android:textSize="10sp"
									android:textStyle="bold"
									android:textColor="#C6D8E6"
									android:layout_weight="1" />
								<TextView
									android:id="@+id/team_squad"
									android:layout_width="0dp"
									android:layout_height="match_parent"
									android:gravity="center_horizontal|center_vertical"
									android:text="SQUAD"
									android:textSize="10sp"
									android:textStyle="bold"
									android:textColor="#C6D8E6"
									android:layout_weight="1" />
							</LinearLayout>
							<TextView
								android:id="@+id/room_players"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								android:padding="8dp"
								android:background="@drawable/bg_hud_chip"
								android:text="1 / 12 players  •  tap for list"
								android:textSize="11sp"
								android:textColor="#FFFFFF" />
							<TextView
								android:id="@+id/btn_leave"
								android:layout_width="match_parent"
								android:layout_height="30dp"
								android:layout_marginTop="8dp"
								android:background="@drawable/bg_btn_ghost"
								android:gravity="center_horizontal|center_vertical"
								android:text="LEAVE ROOM"
								android:textSize="10sp"
								android:textStyle="bold"
								android:textColor="#FF8A8A" />
						</LinearLayout>
						<TextView
							android:id="@+id/room_info"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp"
							android:text="Not connected"
							android:textSize="10sp"
							android:textColor="#B5C9D5"
							android:maxLines="2" />
					</LinearLayout>
				</LinearLayout>
			</ScrollView>
			<FrameLayout
				android:id="@+id/frame_layout18"
				android:layout_width="match_parent"
				android:layout_height="72dp"
				android:layout_marginTop="12dp">
				<View
					android:id="@+id/view19"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/bg_glow_gold" />
				<LinearLayout
					android:id="@+id/btn_start"
					android:layout_width="match_parent"
					android:layout_height="60dp"
					android:background="@drawable/bg_start_btn_premium"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="center_horizontal|center_vertical">
					<ImageView
						android:id="@+id/imageview16"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/ic_play"
						android:scaleType="center"
						android:contentDescription="@null"
						app:tint="#17212B" />
					<TextView
						android:id="@+id/btn_start_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="START"
						android:textSize="22sp"
						android:textStyle="bold"
						android:textColor="#17212B"
						android:layout_marginStart="10dp" />
				</LinearLayout>
			</FrameLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/squad_slots"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="14dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal"
			android:layout_gravity="center_horizontal|bottom"
			android:layout_marginStart="86dp"
			android:layout_marginEnd="280dp" />
		<FrameLayout
			android:id="@+id/name_tags"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />
		<LinearLayout
			android:id="@+id/friends_drawer"
			android:layout_width="300dp"
			android:layout_height="match_parent"
			android:padding="14dp"
			android:background="@drawable/bg_drawer"
			android:orientation="vertical"
			android:layout_gravity="end"
			android:visibility="gone">
			<LinearLayout
				android:id="@+id/linear20"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview15"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="FRIENDS"
					android:textSize="16sp"
					android:textStyle="bold"
					android:textColor="#FFD45A"
					android:layout_weight="1" />
				<ImageView
					android:id="@+id/friends_close"
					android:layout_width="30dp"
					android:layout_height="30dp"
					android:padding="8dp"
					android:background="@drawable/bg_btn_round"
					android:src="@drawable/ic_close"
					android:scaleType="center"
					android:contentDescription="@null" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview16"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="Pending • Invites • Friends"
				android:textSize="10sp"
				android:textColor="#9CB3C4" />
			<ScrollView
				android:id="@+id/vscroll2"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_marginTop="10dp"
				android:layout_weight="1"
				android:fillViewport="false">
				<LinearLayout
					android:id="@+id/friends_list"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical" />
			</ScrollView>
			<TextView
				android:id="@+id/friends_add"
				android:layout_width="match_parent"
				android:layout_height="42dp"
				android:background="@drawable/bg_btn_secondary"
				android:gravity="center_horizontal|center_vertical"
				android:text="+  ADD FRIEND"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="#FFD45A" />
		</LinearLayout>
	</FrameLayout>
</FrameLayout>
