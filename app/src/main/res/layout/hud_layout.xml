	<FrameLayout
		android:id="@+id/hud_map_panel"
		android:layout_width="400dp"
		android:layout_height="match_parent"
		android:background="@drawable/bg_panel_dark"
		android:layout_gravity="end"
		android:visibility="gone">
		<com.avyansh.battleroyale.MapView
			android:id="@+id/hud_map_view"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />
		<LinearLayout
			android:id="@+id/linear146"
			android:layout_width="match_parent"
			android:layout_height="40dp"
			android:background="#AA0A121A"
			android:gravity="center_vertical"
			android:paddingStart="12dp"
			android:paddingEnd="6dp">
			<ImageView
				android:id="@+id/imageview120"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:src="@drawable/ic_map"
