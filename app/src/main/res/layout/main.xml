<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#0A0E1A">
	<View
		android:id="@+id/view13"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/bg_auth_gradient" />
	<View
		android:id="@+id/view14"
		android:layout_width="match_parent"
		android:layout_height="280dp"
		android:background="@drawable/bg_top_glow" />
	<ScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/linear15"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="60dp"
			android:paddingBottom="32dp"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:paddingStart="24dp"
			android:paddingEnd="24dp">
			<FrameLayout
				android:id="@+id/frame_layout16"
				android:layout_width="96dp"
				android:layout_height="96dp">
				<ImageView
					android:id="@+id/imageview2"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/bg_logo_badge"
					android:src="@drawable/default_image"
					android:scaleType="center"
					android:contentDescription="@string/app_name" />
				<TextView
					android:id="@+id/textview8"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="AV"
					android:textSize="32sp"
					android:textStyle="bold"
					android:textColor="#FFC542"
					android:layout_gravity="center_horizontal|center_vertical"
					android:fontFamily="sans-serif-condensed"
					android:letterSpacing="0.05" />
			</FrameLayout>
			<TextView
				android:id="@+id/textview9"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:text="AVYANSH"
				android:textSize="34sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:letterSpacing="0.18"
				android:fontFamily="sans-serif-condensed"
				android:shadowColor="#FF8A00"
				android:shadowRadius="14"
				android:shadowDx="0"
				android:shadowDy="0" />
			<TextView
				android:id="@+id/textview10"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="BATTLE  ROYALE"
				android:textSize="13sp"
				android:textColor="#FFC542"
				android:letterSpacing="0.4"
				android:fontFamily="sans-serif-medium" />
			<View
				android:id="@+id/view17"
				android:layout_width="60dp"
				android:layout_height="2dp"
				android:layout_marginTop="16dp"
				android:background="@drawable/bg_divider_gold" />
			<TextView
				android:id="@+id/statusText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="26dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Connecting securely when you sign in…"
				android:textSize="13sp"
				android:textColor="#B8C1D9"
				android:fontFamily="sans-serif" />
			<ProgressBar
				android:id="@+id/progressBar"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginTop="12dp"
				android:indeterminate="false"
				style="?android:progressBarStyle"
				android:indeterminateTint="#FFC542"
				android:visibility="gone" />
			<LinearLayout
				android:id="@+id/linear18"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:paddingTop="24dp"
				android:paddingBottom="24dp"
				android:background="@drawable/bg_card"
				android:orientation="vertical"
				android:paddingStart="20dp"
				android:paddingEnd="20dp">
				<TextView
					android:id="@+id/textview11"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="USERNAME  /  EMAIL"
					android:textSize="11sp"
					android:textStyle="bold"
					android:textColor="#FFC542"
					android:letterSpacing="0.15"
					android:fontFamily="sans-serif-medium" />
				<EditText
					android:id="@+id/identityInput"
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:layout_marginTop="8dp"
					android:background="@drawable/bg_input"
					android:textSize="15sp"
					android:textColor="#FFFFFF"
					android:hint="Enter username or email"
					android:textColorHint="#5A6478"
					android:singleLine="true"
					android:inputType="textEmailAddress"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:fontFamily="sans-serif" />
				<TextView
					android:id="@+id/textview12"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:text="PASSWORD"
					android:textSize="11sp"
					android:textStyle="bold"
					android:textColor="#FFC542"
					android:letterSpacing="0.15"
					android:fontFamily="sans-serif-medium" />
				<FrameLayout
					android:id="@+id/frame_layout19"
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:layout_marginTop="8dp">
					<EditText
						android:id="@+id/passwordInput"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:background="@drawable/bg_input"
						android:textSize="15sp"
						android:textColor="#FFFFFF"
						android:hint="Enter password (10+ characters)"
						android:textColorHint="#5A6478"
						android:singleLine="true"
						android:inputType="textPassword"
						android:paddingStart="16dp"
						android:paddingEnd="52dp"
						android:fontFamily="sans-serif" />
					<ImageButton
						android:id="@+id/togglePassword"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:background="?android:attr/selectableItemBackgroundBorderless"
						android:scaleType="center"
						android:layout_gravity="end|center_vertical"
						android:src="@android:drawable/ic_menu_view"
						android:layout_marginEnd="6dp"
						android:contentDescription="Togglepasswordvisibility"
						android:tint="#7A879E" />
				</FrameLayout>
				<TextView
					android:id="@+id/errorText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:gravity="center_horizontal|center_vertical"
					android:textSize="13sp"
					android:textColor="#FF6B6B"
					android:visibility="gone"
					android:fontFamily="sans-serif" />
				<Button
					android:id="@+id/loginButton"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:layout_marginTop="20dp"
					android:background="@drawable/bg_btn_primary"
					android:text="LOGIN"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="#0A0E1A"
					android:letterSpacing="0.15"
					android:fontFamily="sans-serif-medium"
					android:stateListAnimator="@null" />
				<LinearLayout
					android:id="@+id/linear20"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<View
						android:id="@+id/view21"
						android:layout_width="0dp"
						android:layout_height="1dp"
						android:background="#1E2637"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/textview13"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="OR"
						android:textSize="11sp"
						android:textColor="#5A6478"
						android:paddingStart="14dp"
						android:paddingEnd="14dp"
						android:letterSpacing="0.2" />
					<View
						android:id="@+id/view22"
						android:layout_width="0dp"
						android:layout_height="1dp"
						android:background="#1E2637"
						android:layout_weight="1" />
				</LinearLayout>
				<Button
					android:id="@+id/googleButton"
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:layout_marginTop="12dp"
					android:background="@drawable/bg_btn_secondary"
					android:text="CONTINUE WITH GOOGLE"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="#FFC542"
					android:letterSpacing="0.08"
					android:fontFamily="sans-serif-medium"
					android:stateListAnimator="@null" />
				<Button
					android:id="@+id/registerButton"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:layout_marginTop="18dp"
					android:background="@drawable/bg_btn_secondary"
					android:text="CREATE  ACCOUNT"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="#FFC542"
					android:letterSpacing="0.15"
					android:fontFamily="sans-serif-medium"
					android:stateListAnimator="@null" />
			</LinearLayout>
			<Button
				android:id="@+id/retryButton"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:layout_marginTop="16dp"
				android:background="@drawable/bg_btn_danger"
				android:text="RETRY  CONNECTION"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:letterSpacing="0.15"
				android:visibility="gone"
				android:fontFamily="sans-serif-medium" />
			<TextView
				android:id="@+id/textview14"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="28dp"
				android:text="SECURED  •  ENCRYPTED  •  SERVER-AUTHORITATIVE"
				android:textSize="10sp"
				android:textColor="#3D4658"
				android:letterSpacing="0.1" />
		</LinearLayout>
	</ScrollView>
</FrameLayout>
